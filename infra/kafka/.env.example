# Copy to .env and fill in. .env is git-ignored.

# The public DNS name of the VM. Teams and the grader connect to it.
KAFKA_HOST=workshop-kafka.westeurope.cloudapp.azure.com

# Any base64 UUID, the same for all brokers. Make one with:
#   docker run --rm apache/kafka:4.4.0 /opt/kafka/bin/kafka-storage.sh random-uuid
CLUSTER_ID=

# Password for the brokers' TLS keystore. gen-certs.sh uses it too.
# Use letters and digits only, here and for ADMIN_PASSWORD.
KEYSTORE_PASSWORD=

# The grader's Kafka super user. create-admin.sh creates it.
ADMIN_USERNAME=grader
ADMIN_PASSWORD=
